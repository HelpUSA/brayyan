{
  "buildCommand": "echo static",
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/docs",
      "destination": "https://brayyan-production.up.railway.app/docs"
    },
    {
      "source": "/docs/:path*",
      "destination": "https://brayyan-production.up.railway.app/docs/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}